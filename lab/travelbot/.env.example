# OpenRouter API key (required for all versions)
OPENROUTER_API_KEY=your-key-here

# PostgreSQL (v3+ with SESSION_BACKEND=database)
PG_HOST=localhost
PG_PORT=5432
PG_DB=travelbot
PG_USER=travelbot
PG_PASSWORD=pg_secret

# Redis (v3+ with SESSION_BACKEND=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_SESSION_TTL=3600

# RAG knowledge base (v3 — local ChromaDB, all defaults usually work)
# Embeddings are generated via OpenRouter (reuses OPENROUTER_API_KEY above).
# RAG_PERSIST_DIR=chroma_db
# RAG_COLLECTION_NAME=travel_kb
# RAG_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
# RAG_TOP_K=3


# Copy this file to .env and fill in your values.
# The demo loads it automatically via python-dotenv.

# ── OpenRouter API key (used for both chat and embedding models) ─────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Vector backend (the single swap point — see kb.get_backend) ──────────
# memory                 → ChromaDB EphemeralClient, in-process, nothing
#                          else to set up (default — what the scripted
#                          demo runs against)
# opensearch             → AWS OpenSearch k-NN index on a managed domain
# opensearch-serverless  → AWS OpenSearch Serverless k-NN collection
#                          (see README.md for how to provision one)
#
# Both OpenSearch options need the settings below plus AWS credentials the
# default boto3 chain can discover (env vars, ~/.aws/credentials, an
# instance role, ...) — and that principal must be listed in the
# collection's data-access policy if you're using Serverless.
VECTOR_BACKEND=memory

# ── Only read when VECTOR_BACKEND=opensearch ─────────────────────────────
# A *domain* endpoint — note the "es" in the hostname:
# OPENSEARCH_HOST=search-my-domain-xxxxxxxxxxxx.us-east-1.es.amazonaws.com

# ── Only read when VECTOR_BACKEND=opensearch-serverless ──────────────────
# A *collection* endpoint — note the "aoss" in the hostname (this is what
# `aws opensearchserverless batch-get-collection` prints as collectionEndpoint,
# minus the "https://"):
# OPENSEARCH_HOST=xxxxxxxxxxxxxxxxxxxx.us-east-1.aoss.amazonaws.com

# ── Read by both OpenSearch options ───────────────────────────────────────
# AWS_REGION=us-east-1
# OPENSEARCH_INDEX=day06_travel_docs

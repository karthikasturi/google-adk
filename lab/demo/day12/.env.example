# Day 12 — Reasoning Loops, Observability, and Evaluation
#
# Copy to .env and fill in your keys.

OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── LangSmith tracing (optional) ──────────────────────────────────────────
# Leave unset to run the demo with console-only reasoning traces — every
# scenario still works, it just won't show up in LangSmith.
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=day12-travelbot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # use the apac endpoint if your org is on the APAC region

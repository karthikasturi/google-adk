# Copy this file to .env and fill in your values.
# The backend loads it automatically via python-dotenv.
# The frontend reads API_BASE only — no secrets needed there.

# ── OpenRouter API key (required by the backend) ──────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Frontend → backend URL (optional, defaults to http://localhost:8000) ───────
# API_BASE=http://localhost:8000

# ── Simulated hotel search error (optional) ───────────────────────────────────
# Set to 1 to make search_hotels return an error response, exercising
# the graceful error path in the Gradio frontend.
# SIMULATE_HOTEL_ERROR=1

# Copy this file to .env and fill in your values.
# The demo loads it automatically via python-dotenv.
# The same .env is also read by `docker compose` for the litellm service.

# ── OpenRouter API key ───────────────────────────────────────────────────
# Used by the litellm gateway container to call OpenRouter — the Python
# demo process never talks to OpenRouter directly.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── LiteLLM gateway ────────────────────────────────────────────────────────
# Must match what the litellm container is started with (see
# docker-compose.yml). Change this if you're running the gateway anywhere
# other than localhost.
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-day07a-local

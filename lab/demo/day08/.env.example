# Copy this file to .env and fill in your values.
# The demo loads it automatically via python-dotenv.

# ── OpenRouter API key ───────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Scenario 3A: hotel MCP server timeout demo ────────────────────────────
# How long the hotel-search MCP server artificially sleeps before replying,
# simulating a slow upstream provider. Used by agent.py's timeout_demo_agent.
HOTEL_SEARCH_DELAY_SECONDS=8

# How long the timeout-demo hotel toolset waits for a tool call before
# giving up. Keep this shorter than HOTEL_SEARCH_DELAY_SECONDS so the call
# times out and ADK returns a graceful error to the agent instead of hanging.
HOTEL_TOOL_TIMEOUT_SECONDS=3

# ── Booking MCP server (Streamable HTTP) ──────────────────────────────────
# agent.py starts mcp_servers/booking_server.py as a background HTTP server
# and connects to it at http://<host>:<port>/mcp. Change these only if the
# default port is already in use.
BOOKING_SERVER_HOST=127.0.0.1
BOOKING_SERVER_PORT=8765

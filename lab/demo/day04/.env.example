# Copy this file to .env and fill in your values.
# The demo loads it automatically via python-dotenv.

# ── OpenRouter API key ────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── PostgreSQL (matches docker-compose.yml defaults) ──────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=travelbot
PG_USER=travelbot
PG_PASSWORD=pg_secret

# ── Redis (matches docker-compose.yml defaults) ───────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
# TTL in seconds for session state cached in Redis (default 1 hour)
REDIS_SESSION_TTL=3600

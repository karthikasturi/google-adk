# Copy this file to .env and fill in your key.
# This one key is used for the agent (Gemini), STT, and TTS.

OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional overrides — defaults work for most setups:
# OPENROUTER_STT_MODEL=google/gemini-2.5-flash
# OPENROUTER_TTS_MODEL=openai/gpt-audio        # gpt-audio-mini is cheaper but slower
# OPENROUTER_TTS_VOICE=alloy
# OPENROUTER_TTS_DEADLINE=45                   # seconds before a slow TTS call aborts

# ── Local Whisper Docker service (whisper-service/) ───────────────────────────
# Set this if you swap OpenRouterSTT for WhisperServiceSTT in pipeline.py.
# WHISPER_SERVICE_URL=http://localhost:8001
